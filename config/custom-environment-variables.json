{
  "domain": "JOB_DOMAIN",
  "telemetry": {
    "serviceName": "TELEMETRY_SERVICE_NAME",
    "hostname": "TELEMETRY_HOST_NAME",
    "version": "TELEMETRY_SERVICE_VERSION",
    "logger": {
      "level": "LOG_LEVEL",
      "prettyPrint": {
        "__name": "LOG_PRETTY_PRINT_ENABLED",
        "__format": "boolean"
      }
    },
    "tracing": {
      "enabled": "TELEMETRY_TRACING_ENABLED",
      "url": "TELEMETRY_TRACING_URL"
    },
    "metrics": {
      "enabled": "TELEMETRY_METRICS_ENABLED",
      "url": "TELEMETRY_METRICS_URL",
      "interval": "TELEMETRY_METRICS_INTERVAL"
    }
  },
  "tiles_storage_provider": "TILES_STORAGE_PROVIDER",
  "fs": {
    "tiles_location": "FS_TILES_LOCATION",
    "sources_location": "FS_SOURCES_LOCATION",
    "blacklist_sources_location": {
      "__name": "FS_BLACK_LIST_SOURCES_LOCATION",
      "__format": "json"
    }
  },
  "s3": {
    "apiVersion": "S3_API_VERSION",
    "endpoint": "S3_ENDPOINT",
    "accessKeyId": "S3_ACCESS_KEY_ID",
    "secretAccessKey": "S3_SECRET_ACCESS_KEY",
    "sslEnabled": {
      "__name": "S3_SSL_ENABLED",
      "__format": "boolean"
    },
    "maxRetries": {
      "__name": "S3_MAX_RETRIES",
      "__format": "number"
    },
    "bucket": "S3_BUCKET"
  },
  "batch_size": {
    "discreteLayers": {
      "__name": "BATCH_SIZE_DISCRETE_LAYERS",
      "__format": "number"
    },
    "tiffDirectoryDeletion": {
      "__name": "BATCH_SIZE_DIRECTORY_TIFF_DELETION",
      "__format": "number"
    },
    "tilesDeletion": {
      "__name": "BATCH_SIZE_TILES_DELETION",
      "__format": "number"
    }
  },
  "failed_cleanup_delay_days": {
    "ingestion": {
      "__name": "FAILED_INGESTION_CLEANUP_DELAY_DAYS",
      "__format": "number"
    }
  },
  "success_cleanup_delay_days": {
    "ingestion": {
      "__name": "SUCCESS_INGESTION_CLEANUP_DELAY_DAYS",
      "__format": "number"
    }
  },
  "disableSourcesCleanup": {
    "__name": "DISABLE_SOURCES_CLEANUP",
    "__format": "boolean"
  },
  "serviceUrls": {
    "jobManager": "JOB_MANAGER_URL",
    "mapproxyApi": "MAPPROXY_API_URL"
  },
  "httpRetry": {
    "attempts": {
      "__name": "HTTP_RETRY_ATTEMPTS",
      "__format": "number"
    },
    "delay": "HTTP_RETRY_DELAY",
    "shouldResetTimeout": {
      "__name": "HTTP_RETRY_SHOULD_RESET_TIMEOUT",
      "__format": "boolean"
    }
  },
  "disableHttpClientLogs": {
    "__name": "DISABLE_HTTP_CLIENT_LOGS",
    "__format": "boolean"
  },
  "jobDefinitions": {
    "jobs": {
      "new": {
        "type": "INGESTION_NEW_JOB_TYPE"
      },
      "update": {
        "type": "INGESTION_UPDATE_JOB_TYPE"
      },
      "swapUpdate": {
        "type": "INGESTION_SWAP_UPDATE_JOB_TYPE"
      },
      "export": {
        "type": "EXPORT_JOB_TYPE"
      }
    }
  },
  "cleanupTypes": {
    "failedIngestionTasks": {
      "__name": "CLEANUP_TYPES_FAILED_INGESTION_TASKS",
      "__format": "boolean"
    },
    "successfulIngestion": {
      "__name": "CLEANUP_TYPES_SUCCESSFUL_INGESTION",
      "__format": "boolean"
    },
    "successfulSwapUpdate": {
      "__name": "CLEANUP_TYPES_SUCCESSFUL_SWAP_UPDATE_TASKS",
      "__format": "boolean"
    }
  }
}
